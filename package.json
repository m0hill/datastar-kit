{
  "name": "ts-star",
  "version": "0.0.0",
  "description": "Exploratory Effect + Datastar framework prototype",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm run typecheck && pnpm run test",
    "check:examples": "pnpm run typecheck && pnpm run test:examples",
    "test": "vitest run",
    "test:example:counter": "vitest run test/example-counter.test.ts",
    "test:example:live-counter": "vitest run test/live-counter-example.test.ts",
    "test:example:search": "vitest run test/search-example.test.ts",
    "test:example:tsx-counter": "vitest run test/example-tsx-counter.test.ts",
    "test:examples": "vitest run test/example-counter.test.ts test/example-tsx-counter.test.ts test/search-example.test.ts test/live-counter-example.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "datastar",
    "effect",
    "sse",
    "hypermedia"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.67",
    "effect": "4.0.0-beta.67"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
