{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "datastar-kit",
  "main": "src/index.tsx",
  "compatibility_date": "2026-05-21",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "datastar-kit.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public"
  }
}
