{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worker-hono-live-todos",
  "main": "src/index.tsx",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_TODOS",
        "class_name": "LiveTodos"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LiveTodos"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "todos",
      "database_id": "aekjh234n35opmlqw2345",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
