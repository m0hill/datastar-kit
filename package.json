{
  "name": "datastar-kit-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm --filter datastar-kit build && pnpm --filter @datastar-kit/examples build:only",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test",
    "dev": "pnpm run dev:counter",
    "dev:append-list": "pnpm --filter @datastar-kit/examples dev:append-list",
    "dev:counter": "pnpm --filter @datastar-kit/examples dev:counter",
    "dev:hono-counter": "pnpm --filter @datastar-kit/examples dev:hono-counter",
    "dev:hono-live-counter": "pnpm --filter @datastar-kit/examples dev:hono-live-counter",
    "dev:live-counter": "pnpm --filter @datastar-kit/examples dev:live-counter",
    "dev:search": "pnpm --filter @datastar-kit/examples dev:search",
    "dev:todo-sync": "pnpm --filter @datastar-kit/examples dev:todo-sync",
    "dev:tsx-counter": "pnpm --filter @datastar-kit/examples dev:tsx-counter",
    "dev:validation-form": "pnpm --filter @datastar-kit/examples dev:validation-form",
    "test": "pnpm --filter datastar-kit test",
    "typecheck": "pnpm --filter datastar-kit typecheck && pnpm --filter @datastar-kit/examples typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
