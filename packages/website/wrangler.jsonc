{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "datastar-kit",
  "compatibility_date": "2026-05-21",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "datastar-kit.mohil.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./.vitepress/dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
