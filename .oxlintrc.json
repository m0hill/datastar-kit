{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "vitest", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    ".pi-cache/**",
    ".pnpm-store/**",
    "packages/**/dist/**",
    "examples/**/dist/**",
    "examples/**/static/**",
    "examples/**/public/**"
  ],
  "rules": {
    "no-constant-condition": "off",
    "no-console": "off",
    "no-control-regex": "off",
    "no-unused-vars": "warn",
    "typescript/no-base-to-string": "warn",
    "typescript/no-explicit-any": "off",
    "vitest/no-standalone-expect": "off"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "options": {
    "typeAware": true
  }
}
