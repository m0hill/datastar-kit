{
  "name": "datastar-kit-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm --filter datastar-kit build && pnpm --filter @datastar-kit/example-fetch-counter build:only",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test",
    "dev": "pnpm run dev:fetch-counter",
    "dev:fetch-counter": "pnpm --filter @datastar-kit/example-fetch-counter dev",
    "examples:check": "pnpm --filter @datastar-kit/example-fetch-counter check",
    "test": "pnpm --filter datastar-kit test",
    "typecheck": "pnpm --filter datastar-kit typecheck && pnpm --filter @datastar-kit/example-fetch-counter typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
